# Copy this file to `.env` and paste your secret values.
# `.env` is gitignored — never commit it.
#
# Docker Compose: `docker compose up --build`
# On Render: set the same variables under Web Service → Environment
# (do not put API keys in the repo or in render.yaml).

# --- App ---
PORT=5001

# --- MongoDB (db.py) ---
# Local (Flask on host): mongodb://localhost:27017/documind
# Docker Compose (app service → mongo service):
MONGODB_URI=mongodb://mongo:27017/documind

# --- Auth (auth.py / flask-jwt-extended) ---
# Required in production; a weak dev default is used when unset
JWT_SECRET_KEY=

# --- S3 artifacts (storage.py) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=documind-artifacts
# AWS_REGION=us-east-1

# --- Existing doc generation (doc_generator.py) ---
OPENAI_API_KEY=

# --- LLM factory (llm_factory.py) ---
# Chat model provider: openai | anthropic | llama (future) | gemini (future)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Embedding provider: openai | local
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Provider API keys (set only what you use)
ANTHROPIC_API_KEY=
# LLAMA_API_KEY=
# GOOGLE_API_KEY=

# --- Vector index (vector_index.py) ---
# Local/Docker: chroma (default). Cloud/Render: pinecone
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIR=.chroma
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=documind

# --- Vector search (vector_search.py) ---
# VECTOR_HYBRID_ENABLED=true
# VECTOR_HYBRID_ALPHA=0.5
# VECTOR_RERANK_ENABLED=false
# VECTOR_RERANK_TOP_N=20
# VECTOR_RERANK_MODE=lexical

# --- Code graph (code_graph.py) ---
GRAPH_PERSIST_DIR=.graph_store

# --- LangSmith tracing (tracing.py) ---
# LANGCHAIN_TRACING_V2=true
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=documind
# LANGCHAIN_API_KEY=

# --- Evaluation harness (eval/run_eval.py) ---
# RAGAS_JUDGE_MODEL=gpt-4o-mini
# RAGAS_JUDGE_EMBEDDING_MODEL=text-embedding-3-small
